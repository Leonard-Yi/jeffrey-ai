generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Person {
  id                String              @id @default(uuid())
  name              String
  /// HMAC-SHA256(name, pseudoKey) — deterministic blind index for exact-name lookup
  /// without storing the name in plaintext. Same name + same key = same hash.
  nameHash          String?
  /// WeightedTag[] stored as JSONB: [{ name, weight }]
  careers           Json                @default("[]")
  /// WeightedTag[] stored as JSONB: [{ name, weight }]
  interests         Json                @default("[]")
  /// string[] stored as a native Postgres text array
  vibeTags          String[]            @default([])
  /// Cities where the person is based, for geographic clustering
  baseCities        String[]            @default([])
  /// Favorite places person visits, for place-based connections
  favoritePlaces    String[]            @default([])
  /// 0–100 intimacy/activity score, updated after each interaction
  relationshipScore Float               @default(0)
  lastContactDate   DateTime
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  /// Multiple introducers stored as a native Postgres text array
  introducedByIds  String[]            @default([])
  /// Optional reference to the person who introduced this contact
  introducedById    String?
  /// Pre-computed search text for LLM-based semantic matching
  searchText        String              @default("")
  /// Embedding vector for semantic search (MiniMax embe-01, stored as JSON float array)
  embedding         Json                @default("[]")
  /// Soft-delete timestamp (set after merge)
  deletedAt         DateTime?
  /// The person this record was merged into (non-null means this record is deprecated)
  mergedIntoId      String?
  mergedInto        Person?             @relation("PersonMerge", fields: [mergedIntoId], references: [id])
  /// People merged into this record
  mergedFrom        Person[]            @relation("PersonMerge")
  /// Multiple aliases/nicknames for the same person (e.g. ["老王", "王总"])
  aliases           String[]            @default([])
  /// Pre-generated icebreaker data (openingLines, topics, context, comment)
  icebreakerData    Json?               @default("null")
  /// When icebreakerData was last generated
  icebreakerGeneratedAt DateTime?
  /// Key version for rotation recovery (incremented on password change)
  encryptionVersion Int                 @default(1)
  interactions      InteractionPerson[]
  introducedBy      Person?             @relation("Introduction", fields: [introducedById], references: [id])
  introductions     Person[]            @relation("Introduction")
  tags              PersonTag[]
  userId           String
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([nameHash, userId])
  @@index([userId])
  @@index([introducedById])
  @@index([mergedIntoId])
  @@index([deletedAt])
}

model Interaction {
  id                String              @id @default(uuid())
  date              DateTime
  location          String?
  contextType       String
  sentiment         String
  /// Key version for rotation recovery (incremented on password change)
  encryptionVersion Int                 @default(1)
  /// ActionItem[] stored as JSONB: [{ description, ownedBy, resolved }]
  actionItems  Json                @default("[]")
  /// string[] stored as native text array
  coreMemories String[]
  createdAt    DateTime            @default(now())
  persons      InteractionPerson[]
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model InteractionPerson {
  personId      String
  interactionId String
  userId        String
  interaction   Interaction @relation(fields: [interactionId], references: [id])
  person        Person      @relation(fields: [personId], references: [id])
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([personId, interactionId])
  @@index([userId])
}

model PersonTag {
  id       String @id @default(uuid())
  personId String
  userId   String
  category String
  name     String
  weight   Float  @default(1.0)
  person   Person @relation(fields: [personId], references: [id])
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([name])
  @@index([userId])
  @@index([category, name])
}

model User {
  id                    String    @id @default(uuid())
  email                 String    @unique
  passwordHash          String
  name                  String?
  emailVerified         DateTime?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  /// 16B random salt for Argon2id key derivation, base64 encoded
  keySalt               String?
  /// Blocks concurrent writes during key rotation
  keyRotationInProgress Boolean   @default(false)

  accounts              Account[]
  sessions              Session[]
  persons               Person[]
  interactions          Interaction[]
  interactionPersons    InteractionPerson[]
  personTags            PersonTag[]
  pseudonymMaps         PseudonymMap[]
}

model Account {
  id                String  @id @default(uuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String? @db.Text
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(uuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String   @unique
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model PseudonymMap {
  id              String   @id @default(uuid())
  userId          String
  /// Real entity name encrypted with enc_key (AES-256-GCM)
  encryptedEntity String
  /// 'person' | 'place' | 'org'
  entityType      String
  /// Deterministic pseudonym e.g. "Person_a7b3c8d9"
  pseudonym       String
  /// HMAC-SHA256(realName + disambigFactor, pseudo_key) for dedup
  entityHash      String
  /// Context hash or timestamp to distinguish same-named entities
  disambigFactor  String
  /// Number of times this pseudonym has been referenced
  usageCount      Int      @default(1)
  createdAt       DateTime @default(now())
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, entityHash])
}
